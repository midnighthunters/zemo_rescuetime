# RevenueCat API Keys
# Get these from your RevenueCat dashboard: https://app.revenuecat.com/

# iOS API Key (from RevenueCat dashboard > Project Settings > API Keys)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your_ios_api_key_here

# Android API Key (from RevenueCat dashboard > Project Settings > API Keys)
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your_android_api_key_here

# RevenueCat entitlement ID (matches what you set in the RevenueCat dashboard)
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# iOS Product IDs (configured in App Store Connect & RevenueCat)
EXPO_PUBLIC_REVENUECAT_IOS_MONTHLY_PRODUCT_ID=monthly_subscription_rescuetime
EXPO_PUBLIC_REVENUECAT_IOS_YEARLY_PRODUCT_ID=annual_rescuetime_sub
